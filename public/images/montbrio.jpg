ction="col" data-d-has-width="" data-d-has-height="" aria-label="Open Holiday Deals - Amazing Travel Deals &amp; Packages" type="button" style="--smoothing-background-color: transparent; border-radius: 0px; background-color: transparent; flex-shrink: 0; height: 100%; width: 100%;"></button></div></div></div><div class="Box-qIMv6G" data-d-component="box" data-d-direction="col" style="--w-box-gutter-block-end: calc(var(--spacing, 0.25rem) * 3); --w-box-gutter-block-start: calc(var(--spacing, 0.25rem) * 3); --w-box-gutter-inline-end: calc(var(--spacing, 0.25rem) * 3); --w-box-gutter-inline-start: calc(var(--spacing, 0.25rem) * 3); padding-block: calc(var(--spacing, 0.25rem) * 3); padding-inline: calc(var(--spacing, 0.25rem) * 3); gap: calc(var(--spacing, 0.25rem) * 3);"><div class="Badge-_iijmO Badge-G_joSy" data-color="success" data-size="sm" data-pill="" data-variant="soft" data-d-component="badge" data-d-weight="medium">Exemple de présentation</div><h1 class="TextBase-hXhSqg Title-HRvkwB" data-d-component="title" data-d-size="2xl" data-d-weight="semibold">Cambrils</h1><p class="TextBase-hXhSqg Text-lIMP0_" data-d-component="text">Ville côtière avec un port, des plages et des commerces ouverts toute l'année.</p><div class="Grid-CGRmTR" data-d-component="grid" style="gap: calc(var(--spacing, 0.25rem) * 3); grid-template-columns: repeat(2, minmax(0px, 1fr));"><div class="Box-qIMv6G Item-ev4eoI" data-d-auto-spacing="" data-d-component="grid-item" data-d-direction="col" style="--grid-item-column: auto; --grid-item-row: auto;"><p class="TextBase-hXhSqg Text-lIMP0_" data-d-component="text" data-d-size="sm" style="color: var(--color-text-secondary);"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-waves" data-d-component="icon" data-d-inline="" style="display: inline-block; vertical-align: text-bottom;"><path d="M2 6c.6.