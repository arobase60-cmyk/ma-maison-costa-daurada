      }

      .question {
        background: white;
        padding: 30px;
        margin-bottom: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px #0000000a;
      }

      .question h2 {
        font-size: 21px;
        color: #167b88;
      }

      .choix {
        display: grid;
        gap: 12px;
        margin-top: 20px;
      }

      label {
        padding: 14px;
        border: 1px solid #d5e1e0;
        border-radius: 8px;
        cursor: pointer;
      }

      label:hover {
        background: #e9f3f2;
      }

      input { margin-right: 10px; }

      button {
        display: block;
        margin: 35px auto;
        padding: 17px 35px;
        background: #e7b65c;
        border: none;
        border-radius: 8px;
        color: #263d46;
        font-size: 17px;
        font-weight: bold;
        cursor: pointer;
      }

#resultat {
  margin-top: 45px;
}

#resultat h2 {
  text-align: center;
  color: #167b88;
  margin-bottom: 30px;
}

.resultats {
  display: grid;
  gap: 20px;
}

.resultat-card {
  background: white;
  border-left: 5px solid #167b88;
  border-radius: 10px;
  padding: 25px;
  box-shadow: 0 4px 15px #00000012;
}

.resultat-card h3 {
  color: #167b88;
  font-size: 24px;
  margin-top: 0;
}

.resultat-card p {
  line-height: 1.7;
}

.resultats {
