// Hydration preserves this seed until AppearanceProvider takes over.
/** @param {string} browserThemeCacheKey */
// oxlint-disable-next-line no-unused-vars -- The raw source is called by browser-theme-bootstrap.ts when constructing the inline script.
function initializeBrowserTheme(browserThemeCacheKey) {
  const root = document.documentElement;
  const preference = root.dataset.appearanceTheme;
  if (preference === "light" || preference === "dark") {
    root.dataset.theme = preference;
  } else {
    root.dataset.theme = window.matchMedia("(prefers-color-scheme: dark)")
      .matches
      ? "dark"
      : "light";
  }
  try {
    const themes = JSON.parse(
      window.localStorage.getItem(browserThemeCacheKey),
    );
    if (
      typeof themes?.css === "string" &&
      typeof themes.light === "boolean" &&
      typeof themes.dark === "boolean" &&
      // The origin-wide cache may belong to a different user or workspace.
      themes.accountId === (root.dataset.themeAccountId ?? null) &&
      themes.userId === (root.dataset.themeUserId ?? null)
    ) {
      document.querySelector("style[data-codex-app-themes]").textContent =
        themes.css;
      root.classList.toggle(
        "chatgpt-theme",
        themes[root.dataset.theme] === true,
      );
    }
  } catch {
    // Unavailable storage or an invalid cache leaves the default palette intact.
  }
}

initializeBrowserTheme("codex.browser.appThemes.v1");})();</script><style>undefined</style><style id="poper-blocker-overlay-styles">
  .poper-blocker-overlay {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    border-width: 1px;
    border-style: dashed;
    border-radius: 8px;

    margin: 10px;
    padding: 5px;
  }

  .poper-blocker-overlay div {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 5px;
  }

  .poper-blocker-overlay div p {
    font-family: 'Mulish', sans-serif;
    font-style: normal;
    font-weight: 700;
    font-size: inherit;
    line-height: 18px;
    color: inherit;
    margin: 0 !important;
    text-align: center;
  }

  .poper-blocker-overlay div img {
    margin: 0 !important;
  }

  .poper-blocker-overlay button {
    font-family: 'Mulish', sans-serif;
    font-style: normal;
    font-weight: 700;
    font-size: inherit;
    color: inherit;
    background-color: transparent;
    border: none;
    cursor: pointer;
    margin: 0;
  }

  .poper-blocker-overlay-hidden-content {
    display: none !important;
  }

  
    .poper-blocker-overlay.pb-medium {
      gap: 12px;
      font-size: 14px;
    }
  
    .poper-blocker-overlay.pb-small {
      gap: 8px;
      font-size: 12px;
    }
  

  
    .poper-blocker-overlay.pb-light {
      background-color: #F5F9FF;
      border-color: #D1D9E0;
      color: #627280;
    }

    .poper-blocker-overlay.pb-light button {
      color: #5B96EE;
    }
  
    .poper-blocker-overlay.pb-dark {
      background-color: #00000014;
      border-color: #FFFFFF3D;
      color: #627280;
    }

    .poper-blocker-overlay.pb-dark button {
      color: #5B96EE;
    }
  
    .poper-blocker-overlay.pb-grey {
      background-color: #FFFFFF29;
      border-color: #FFFFFF3D;
      color: #FFFFFF;
    }

    .poper-blocker-overlay.pb-grey button {
      color: #5B96EE;
    }
  
