-size-code text-default md:px-5 ViewerContent-Cg8AgN pt-0 min-w-max whitespace-pre"><code><span>
</span><span class="text-codex-syntax-name">&lt;h3&gt;</span><span>${</span><span class="text-codex-syntax-variable">commune</span><span class="text-codex-syntax-keyword">.</span><span>nom}</span><span class="text-codex-syntax-name">&lt;/h3&gt;</span><span>

</span><span class="text-codex-syntax-keyword">&lt;</span><span class="text-codex-syntax-variable">p</span><span class="text-codex-syntax-keyword">&gt;</span><span class="text-codex-syntax-variable">$</span><span>{</span><span class="text-codex-syntax-variable">commune</span><span class="text-codex-syntax-keyword">.</span><span>description}&lt;</span><span class="text-codex-syntax-string">/p&gt;</span><span>

</span><span class="text-codex-syntax-keyword">&lt;</span><span class="text-codex-syntax-variable">p</span><span class="text-codex-syntax-keyword">&gt;</span><span>
  </span><span class="text-codex-syntax-name">&lt;strong&gt;</span><span>Distance de la mer :</span><span class="text-codex-syntax-name">&lt;/strong&gt;</span><span>
  </span><span class="text-codex-syntax-variable">$</span><span>{</span><span class="text-codex-syntax-variable">commune</span><span class="text-codex-syntax-keyword">.</span><span>mer </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-literal">0</span><span>
    </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-string">"En bord de mer"</span><span>
    </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-string">"Environ "</span><span> </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-variable">commune</span><span class="text-codex-syntax-keyword">.</span><span>mer </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-string">" minutes"</span><span>}
&lt;</span><span class="text-codex-syntax-string">/p&gt;</span><span>

</span><span class="text-codex-syntax-keyword">&lt;</span><span class="text-codex-syntax-variable">p</span><span class="text-codex-syntax-keyword">&gt;</span><span>
  </span><span class="text-codex-syntax-name">&lt;strong&gt;</span><span>Prix moyen au m² :</span><span class="text-codex-syntax-name">&lt;/strong&gt;</span><span>
  </span><span class="text-codex-syntax-variable">$</span><span>{</span><span class="text-codex-syntax-variable">commune</span><span class="text-codex-syntax-keyword">.</span><span>prixM2 </span><span class="text-codex-syntax-keyword">!==</span><span> </span><span class="text-codex-syntax-literal">null</span><span>
    </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-variable">commune</span><span class="text-codex-syntax-keyword">.</span><span>prixM2</span><span class="text-codex-syntax-keyword">.</span><span>toLocaleString(</span><span class="text-codex-syntax-string">"fr-FR"</span><span>, {
        style: </span><span class="text-codex-syntax-string">"currency"</span><span>,
        currency: </span><span class="text-codex-syntax-string">"EUR"</span><span>
      })
    </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-string">"Données à compléter"</span><span>}
&lt;</span><span class="text-codex-syntax-string">/p&gt;</span><span>
  </span></code></pre></div></div></div><button class="cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Faire défiler jusqu’en bas" tabindex="-1" type="button"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon rotate-180 text-default"><path d="M9.33467 16.6663V4.93978L4.6374 9.63704L4.1667 9.16634L3.69599 8.69661L9.52998 2.86263L9.63447 2.77767C9.8925 2.60753 10.2433 2.63564 10.4704 2.86263L16.3034 8.69661L16.3884 8.80111C16.5588 9.05922 16.5306 9.40982 16.3034 9.63704C16.0762 9.86414 15.7255 9.89242 15.4675 9.722L15.363 9.63704L10.6647 4.9388V16.6663C10.6647 17.0336 10.367 17.3314 9.99971 17.3314C9.63259 17.3312 9.33467 17.0335 9.33467 16.6663ZM4.6374 9.63704C4.3777 9.89674 3.95569 9.89674 3.69599 9.63704C3.43657 9.37744 3.43668 8.95628 3.69599 8.69661L4.6374 9.63704Z" fill="currentColor"></path></svg></button></div></div></div></div></div><p class="TextBase-hXhSqg Text-lIMP0_" data-d-component="text">Tu dois donc remplacer l'ancien passage, et non ajouter un deuxième paragraphe « Distance de la mer ».</p><h3 class="TextBase-hXhSqg Title-HRvkwB" data-d-component="title" data-d-size="md" data-d-weight="semibold">3. Supprimer l'ancienne distance</h3><p class="TextBase-hXhSqg Text-lIMP0_" data-d-component="text">Plus bas, après le budget, s'il reste ces lignes, supprime-les :</p><div><div class="CodeBlock-zu1QM3"><div data-markdown-copy="code-block" class="relative w-full min-w-0 overflow-clip contain-inline-size rounded-(--radius-3xl-base) border border-subtle bg-secondary-soft-alpha Surface-dfq13n light @container" data-theme="light" data-search-result-target=""><div data-markdown-copy="exclude" class="flex items-center font-sans text-sm select-none min-h-12 