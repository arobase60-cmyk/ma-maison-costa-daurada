__dil.jsx(\\\"table-cell\\\",null,__dilConstants[\\\"44\\\"])),__dil.jsx(\\\"table-row\\\",null,__dil.jsx(\\\"table-cell\\\",null,__dilConstants[\\\"45\\\"]),__dil.jsx(\\\"table-cell\\\",null,__dilConstants[\\\"46\\\"]))),__dil.jsx(\\\"text\\\",null,__dilConstants[\\\"47\\\"],__dil.jsx(\\\"bold\\\",null,__dilConstants[\\\"48\\\"]),__dilConstants[\\\"49\\\"]),__dil.jsx(\\\"text\\\",{\\\"weight\\\":\\\"semibold\\\"},__dilConstants[\\\"50\\\"]),__dil.jsx(\\\"text\\\",null,__dilConstants[\\\"51\\\"])),__dil.jsx(\\\"text\\\",{\\\"color\\\":\\\"secondary\\\",\\\"size\\\":\\\"sm\\\"},__dilConstants[\\\"52\\\"]),__dil.jsx(\\\"text\\\",null,__dilConstants[\\\"53\\\"]));},{\\\"key\\\":\\\"body:0\\\"}));\",\"constants\",{\"_181\":182,\"_183\":184,\"_185\":186,\"_187\":188,\"_189\":190,\"_191\":192,\"_193\":194,\"_195\":196,\"_197\":198,\"_199\":200,\"_201\":202,\"_203\":204,\"_205\":170,\"_206\":-5,\"_207\":208,\"_209\":210,\"_211\":212,\"_213\":186,\"_214\":215,\"_216\":217,\"_218\":219,\"_220\":172,\"_221\":-5,\"_222\":223,\"_224\":225,\"_226\":227,\"_228\":229,\"_230\":231,\"_232\":174,\"_233\":-5,\"_234\":235,\"_236\":237,\"_238\":239,\"_240\":241,\"_242\":243,\"_244\":186,\"_245\":246,\"_247\":248,\"_249\":250,\"_251\":252,\"_253\":254,\"_255\":256,\"_257\":258,\"_259\":260,\"_261\":262,\"_263\":264,\"_265\":266,\"_267\":268,\"_269\":270,\"_271\":186,\"_272\":273,\"_274\":275,\"_276\":277,\"_278\":279},\"fallbackMarkdown\",\"Parfait Bobby \\\\! Nous allons maintenant connecter notre base de données au questionnaire pour afficher les **3 communes correspondant le mieux aux réponses du visiteur**\\\\.\\n\\nNous allons commencer par les critères de proximité de la mer et de type d\\\\'environnement\\\\. Le budget sera intégré lorsque nous aurons ajouté les prix immobiliers\\\\.\\n\\n## Étape 13 — Connecter le questionnaire aux communes\\n\\nOuvre le fichier `src/pages/trouver-ma-ville.astro` dans Visual Studio Code\\\\.\\n\\n### 1\\\\. Importer notre base de données\\n\\nTout en haut du fichier\\\\, juste après les trois tirets `---`\\\\, ajoute cette ligne \\\\:\\n\\n```javascript\\n\\nimport communes from \\\"../data/communes.json\\\";\\n```\\n\\n### 2\\\\. Transmettre les données au questionnaire\\n\\nDescends tout en bas du fichier et repère le bloc `\u003cscript\u003e`\\\\.\\n\\nRemplace entièrement ce bloc\\\\, jusqu\\\\'à `\u003c/script\u003e` inclus\\\\, par le code suivant \\\\:\\n\\n```html\\n\\n\u003cscript\u003e\\n  import communes from \\\"../data/communes.json\\\";\\n\\n  const form = document.querySelector\u003cHTMLFormElement\u003e(\\n    \\\"#questionnaire\\\"\\n  );\\n\\n  const resultat = document.querySelector\u003cHTMLElement\u003e(\\n    \\\"#resultat\\\"\\n  );\\n\\n  form?.addEventListener(\\\"submit\\\", (event) =\u003e {\\n    event.preventDefault();\\n\\n    const donnees = new FormData(form);\\n\\n    const environnement = donnees.get(\\\"question-2\\\");\\n    const mer = donnees.get(\\\"question-3\\\");\\n\\n    const classement = communes.map((commune) =\u003e {\\n      let score = 0;\\n\\n      // Préférence pour le type d'environnement\\n      if (\\n        environnement === \\\"Ville animée toute l'année\\\" \u0026\u0026\\n        commune.animation === \\\"toute_annee\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Petite ville avec commerces\\\" \u0026\u0026\\n        commune.type === \\\"petite_ville\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Village traditionnel\\\" \u0026\u0026\\n        commune.type === \\\"village\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Quartier résidentiel calme\\\" \u0026\u0026\\n        commune.type === \\\"residentiel\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Station balnéaire\\\" \u0026\u0026\\n        commune.type === \\\"station\\\"\\n      ) score += 3;\\n\\n      // Préférence pour la proximité de la mer\\n      if (\\n        mer === \\\"En bord de mer\\\" \u0026\u0026\\n        commune.mer === 0\\n      ) score += 3;\\n\\n      if (\\n        mer === \\\"Moins de 10 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 10\\n      ) score += 2;\\n\\n      if (\\n        mer === \\\"Moins de 20 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 20\\n      ) score += 2;\\n\\n      if (\\n        mer === \\\"Moins de 30 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 30\\n      ) score += 2;\\n\\n      return { ...commune, score };\\n    });\\n\\n    classement.sort((a, b) =\u003e b.score - a.score);\\n\\n    const selection = classement.slice(0, 3);\\n\\n    if (resultat) {\\n      resultat.hidden = false;\\n\\n      resultat.innerHTML = `\\n        \u003ch2\u003eLes communes correspondant à votre recherche\u003c/h2\u003e\\n\\n        \u003cdiv class=\\\"resultats\\\"\u003e\\n          ${selection.map((commune) =\u003e `\\n            \u003carticle class=\\\"resultat-card\\\"\u003e\\n              \u003ch3\u003e${commune.nom}\u003c/h3\u003e\\n              \u003cp\u003e${commune.description}\u003c/p\u003e\\n              \u003cp\u003e\\n                \u003cstrong\u003eDistance de la mer :\u003c/strong\u003e\\n                ${commune.mer === 0\\n                  ? \\\"En bord de mer\\\"\\n                  : `Environ ${commune.mer} minutes`}\\n              \u003c/p\u003e\\n            \u003c/article\u003e\\n          `).join(\\\"\\\")}\\n        \u003c/div\u003e\\n      `;\\n\\n      resultat.scrollIntoView({\\n        behavior: \\\"smooth\\\"\\n      });\\n    }\\n  });\\n\u003c/script\u003e\\n```\\n\\nL\\\\'import placé dans le script est celui qui sert au calcul dans le navigateur\\\\. Celui ajouté en haut du fichier n\\\\'est pas nécessaire pour cette étape \\\\: tu peux donc ne conserver que l\\\\'import du script\\\\.\\n\\n### 3\\\\. Ajouter le style des résultats\\n\\nDans le même fichier\\\\, juste avant `\u003c/style\u003e`\\\\, colle \\\\:\\n\\n```css\\n\\n#resultat {\\n  margin-top: 45px;\\n}\\n\\n#resultat h2 {\\n  text-align: center;\\n  color: #167b88;\\n  margin-bottom: 30px;\\n}\\n\\n.resultats {\\n  display: grid;\\n  gap: 20px;\\n}\\n\\n.resultat-card {\\n  background: white;\\n  border-left: 5px solid #167b88;\\n  border-radius: 10px;\\n  padding: 25px;\\n  box-shadow: 0 4px 15px #00000012;\\n}\\n\\n.resultat-card h3 {\\n  color: #167b88;\\n  font-size: 24px;\\n  margin-top: 0;\\n}\\n\\n.resultat-card p {\\n  line-height: 1.7;\\n}\\n```\\n\\n## 4\\\\. Tester le questionnaire\\n\\nEnregistre avec `Ctrl + S`\\\\, puis ouvre `http://localhost:4321/trouver-ma-ville/`\\\\.\\n\\n## Premier test\\n\\nSélectionne les réponses suivantes \\\\:\\n\\n| Projet | Résidence secondaire |\\n|--------|--------|\\n| Budget | 150 000 à 200 000 € |\\n| Environnement | Village traditionnel |\\n| Mer | Moins de 20 minutes |\\n\\nClique sur **Découvrir les villes**\\\\.\\n\\n**Résultat attendu \\\\:**\\n\\nMont\\\\-roig del Camp\\\\, Montbrió del Camp et Riudoms devraient apparaître dans les résultats\\\\.\\n\\nCes premières suggestions sont expérimentales \\\\: elles reposent uniquement sur les critères géographiques et le type de commune\\\\, sans vérification des prix ni de la disponibilité des logements\\\\.\\n\\nDis\\\\-moi « fait » si les trois communes s\\\\'affichent correctement\\\\, ou envoie\\\\-moi une capture d\\\\'écran si tu rencontres une erreur\\\\.\",\"fallbackMarkdownVersion\",\"clientDefinedWidgets\",{\"_170\":171,\"_172\":173,\"_174\":175},\"appData\",{\"_164\":165},\"opGenui\",{\"_166\":167,\"_168\":169},\"componentResults\",{},\"modelDataBindings\",{},\"180f8412-add4-539f-aa9b-84a2ce1d1dc9\",{\"_11\":176,\"_177\":180,\"_179\":31},\"25f3e4a0-c1c9-5133-a5e2-b0e9eab91b86\",{\"_11\":176,\"_177\":91,\"_179\":31},\"3a4db5f2-c4c7-5b05-aa2a-aaab605b0019\",{\"_11\":176,\"_177\":178,\"_179\":31},\"resolved\",\"refIndex\",2,\"isStreaming\",0,\"0\",\"Parfait Bobby ! Nous allons maintenant connecter notre base de données au questionnaire pour afficher les \",\"1\",\"3 communes correspondant le mieux aux réponses du visiteur\",\"2\",\".\",\"3\",\"Nous allons commencer par les critères de proximité de la mer et de type d'environnement. Le budget sera intégré lorsque nous aurons ajouté les prix immobiliers.\",\"4\",\"Étape 13 — Connecter le questionnaire aux communes\",\"5\",\"Ouvre le fichier \",\"6\",\"src/pages/trouver-ma-ville.astro\",\"7\",\" dans Visual Studio Code.\",\"8\",\"1. Importer notre base de données\",\"9\",\"Tout en haut du fichier, juste après les trois tirets \",\"10\",\"---\",\"11\",\", ajoute cette ligne :\",\"12\",\"13\",\"14\",\"2. Transmettre les données au questionnaire\",\"15\",\"Descends tout en bas du fichier et repère le bloc \",\"16\",\"\u003cscript\u003e\",\"17\",\"18\",\"Remplace entièrement ce bloc, jusqu'à \",\"19\",\"\u003c/script\u003e\",\"20\",\" inclus, par le code suivant :\",\"21\",\"22\",\"23\",\"L'import placé dans le script est celui qui sert au calcul dans le navigateur. Celui ajouté en haut du fichier n'est pas nécessaire pour cette étape : tu peux donc ne conserver que l'import du script.\",\"24\",\"3. Ajouter le style des résultats\",\"25\",\"Dans le même fichier, juste avant \",\"26\",\"\u003c/style\u003e\",\"27\",\", colle :\",\"28\",\"29\",\"30\",\"4. Tester le questionnaire\",\"31\",\"Enregistre avec \",\"32\",\"Ctrl + S\",\"33\",\", puis ouvre \",\"34\",\"http://localhost:4321/trouver-ma-ville/\",\"35\",\"36\",{\"_280\":91,\"_281\":282},\"37\",\"Premier test\",\"38\",\"Sélectionne les réponses suivantes :\",\"39\",\"Projet\",\"40\",\"Résidence secondaire\",\"41\",\"Budget\",\"42\",\"150 000 à 200 000 €\",\"43\",\"Environnement\",\"44\",\"Village traditionnel\",\"45\",\"Mer\",\"46\",\"Moins de 20 minutes\",\"47\",\"Clique sur \",\"48\",\"Découvrir les villes\",\"49\",\"50\",\"Résultat attendu :\",\"51\",\"Mont-roig del Camp, Montbrió del Camp et Riudoms devraient apparaître dans les résultats.\",\"52\",\"Ces premières suggestions sont expérimentales : elles reposent uniquement sur les critères géographiques et le type de commune, sans vérification des prix ni de la disponibilité des logements.\",\"53\",\"Dis-moi « fait » si les trois communes s'affichent correctement, ou envoie-moi une capture d'écran si tu rencontres une erreur.\",\"size\",\"color\",\"#24976c\",{\"_133\":286,\"_287\":134,\"_288\":314,\"_290\":315,\"_292\":316,\"_294\":317,\"_33\":318,\"_297\":319,\"_299\":-5,\"_300\":-5},{\"_133\":286,\"_287\":134,\"_288\":306,\"_290\":307,\"_292\":308,\"_294\":309,\"_33\":310,\"_297\":311,\"_299\":-5,\"_300\":-5},{\"_133\":286,\"_287\":134,\"_288\":289,\"_290\":291,\"_292\":293,\"_294\":295,\"_33\":296,\"_297\":298,\"_299\":-5,\"_300\":-5},\"client_defined_widget\",\"category\",\"data\",{\"_86\":301,\"_302\":303,\"_304\":68,\"_305\":134},\"matched_text\",\"```css\\n\\n#resultat {\\n  margin-top: 45px;\\n}\\n\\n#resultat h2 {\\n  text-align: center;\\n  color: #167b88;\\n  margin-bottom: 30px;\\n}\\n\\n.resultats {\\n  display: grid;\\n  gap: 20px;\\n}\\n\\n.resultat-card {\\n  background: white;\\n  border-left: 5px solid #167b88;\\n  border-radius: 10px;\\n  padding: 25px;\\n  box-shadow: 0 4px 15px #00000012;\\n}\\n\\n.resultat-card h3 {\\n  color: #167b88;\\n  font-size: 24px;\\n  margin-top: 0;\\n}\\n\\n.resultat-card p {\\n  line-height: 1.7;\\n}\\n```\",\"start_idx\",3674,\"end_idx\",4116,[],\"refs\",[],\"alt\",\"prompt_text\",\"\\n#resultat {\\n  margin-top: 45px;\\n}\\n\\n#resultat h2 {\\n  text-align: center;\\n  color: #167b88;\\n  margin-bottom: 30px;\\n}\\n\\n.resultats {\\n  display: grid;\\n  gap: 20px;\\n}\\n\\n.resultat-card {\\n  background: white;\\n  border-left: 5px solid #167b88;\\n  border-radius: 10px;\\n  padding: 25px;\\n  box-shadow: 0 4px 15px #00000012;\\n}\\n\\n.resultat-card h3 {\\n  color: #167b88;\\n  font-size: 24px;\\n  margin-top: 0;\\n}\\n\\n.resultat-card p {\\n  line-height: 1.7;\\n}\\n\",\"language\",\"css\",\"editable\",\"widget_type\",{\"_86\":312,\"_302\":313,\"_304\":68,\"_305\":134},\"```html\\n\\n\u003cscript\u003e\\n  import communes from \\\"../data/communes.json\\\";\\n\\n  const form = document.querySelector\u003cHTMLFormElement\u003e(\\n    \\\"#questionnaire\\\"\\n  );\\n\\n  const resultat = document.querySelector\u003cHTMLElement\u003e(\\n    \\\"#resultat\\\"\\n  );\\n\\n  form?.addEventListener(\\\"submit\\\", (event) =\u003e {\\n    event.preventDefault();\\n\\n    const donnees = new FormData(form);\\n\\n    const environnement = donnees.get(\\\"question-2\\\");\\n    const mer = donnees.get(\\\"question-3\\\");\\n\\n    const classement = communes.map((commune) =\u003e {\\n      let score = 0;\\n\\n      // Préférence pour le type d'environnement\\n      if (\\n        environnement === \\\"Ville animée toute l'année\\\" \u0026\u0026\\n        commune.animation === \\\"toute_annee\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Petite ville avec commerces\\\" \u0026\u0026\\n        commune.type === \\\"petite_ville\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Village traditionnel\\\" \u0026\u0026\\n        commune.type === \\\"village\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Quartier résidentiel calme\\\" \u0026\u0026\\n        commune.type === \\\"residentiel\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Station balnéaire\\\" \u0026\u0026\\n        commune.type === \\\"station\\\"\\n      ) score += 3;\\n\\n      // Préférence pour la proximité de la mer\\n      if (\\n        mer === \\\"En bord de mer\\\" \u0026\u0026\\n        commune.mer === 0\\n      ) score += 3;\\n\\n      if (\\n        mer === \\\"Moins de 10 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 10\\n      ) score += 2;\\n\\n      if (\\n        mer === \\\"Moins de 20 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 20\\n      ) score += 2;\\n\\n      if (\\n        mer === \\\"Moins de 30 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 30\\n      ) score += 2;\\n\\n      return { ...commune, score };\\n    });\\n\\n    classement.sort((a, b) =\u003e b.score - a.score);\\n\\n    const selection = classement.slice(0, 3);\\n\\n    if (resultat) {\\n      resultat.hidden = false;\\n\\n      resultat.innerHTML = `\\n        \u003ch2\u003eLes communes correspondant à votre recherche\u003c/h2\u003e\\n\\n        \u003cdiv class=\\\"resultats\\\"\u003e\\n          ${selection.map((commune) =\u003e `\\n            \u003carticle class=\\\"resultat-card\\\"\u003e\\n              \u003ch3\u003e${commune.nom}\u003c/h3\u003e\\n              \u003cp\u003e${commune.description}\u003c/p\u003e\\n              \u003cp\u003e\\n                \u003cstrong\u003eDistance de la mer :\u003c/strong\u003e\\n                ${commune.mer === 0\\n                  ? \\\"En bord de mer\\\"\\n                  : `Environ ${commune.mer} minutes`}\\n              \u003c/p\u003e\\n            \u003c/article\u003e\\n          `).join(\\\"\\\")}\\n        \u003c/div\u003e\\n      `;\\n\\n      resultat.scrollIntoView({\\n        behavior: \\\"smooth\\\"\\n      });\\n    }\\n  });\\n\u003c/script\u003e\\n```\",864,3366,[],[],\"\\n\u003cscript\u003e\\n  import communes from \\\"../data/communes.json\\\";\\n\\n  const form = document.querySelector\u003cHTMLFormElement\u003e(\\n    \\\"#questionnaire\\\"\\n  );\\n\\n  const resultat = document.querySelector\u003cHTMLElement\u003e(\\n    \\\"#resultat\\\"\\n  );\\n\\n  form?.addEventListener(\\\"submit\\\", (event) =\u003e {\\n    event.preventDefault();\\n\\n    const donnees = new FormData(form);\\n\\n    const environnement = donnees.get(\\\"question-2\\\");\\n    const mer = donnees.get(\\\"question-3\\\");\\n\\n    const classement = communes.map((commune) =\u003e {\\n      let score = 0;\\n\\n      // Préférence pour le type d'environnement\\n      if (\\n        environnement === \\\"Ville animée toute l'année\\\" \u0026\u0026\\n        commune.animation === \\\"toute_annee\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Petite ville avec commerces\\\" \u0026\u0026\\n        commune.type === \\\"petite_ville\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Village traditionnel\\\" \u0026\u0026\\n        commune.type === \\\"village\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Quartier résidentiel calme\\\" \u0026\u0026\\n        commune.type === \\\"residentiel\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Station balnéaire\\\" \u0026\u0026\\n        commune.type === \\\"station\\\"\\n      ) score += 3;\\n\\n      // Préférence pour la proximité de la mer\\n      if (\\n        mer === \\\"En bord de mer\\\" \u0026\u0026\\n        commune.mer === 0\\n      ) score += 3;\\n\\n      if (\\n        mer === \\\"Moins de 10 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 10\\n      ) score += 2;\\n\\n      if (\\n        mer === \\\"Moins de 20 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 20\\n      ) score += 2;\\n\\n      if (\\n        mer === \\\"Moins de 30 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 30\\n      ) score += 2;\\n\\n      return { ...commune, score };\\n    });\\n\\n    classement.sort((a, b) =\u003e b.score - a.score);\\n\\n    const selection = classement.slice(0, 3);\\n\\n    if (resultat) {\\n      resultat.hidden = false;\\n\\n      resultat.innerHTML = `\\n        \u003ch2\u003eLes communes correspondant à votre recherche\u003c/h2\u003e\\n\\n        \u003cdiv class=\\\"resultats\\\"\u003e\\n          ${selection.map((commune) =\u003e `\\n            \u003carticle class=\\\"resultat-card\\\"\u003e\\n              \u003ch3\u003e${commune.nom}\u003c/h3\u003e\\n              \u003cp\u003e${commune.description}\u003c/p\u003e\\n              \u003cp\u003e\\n                \u003cstrong\u003eDistance de la mer :\u003c/strong\u003e\\n                ${commune.mer === 0\\n                  ? \\\"En bord de mer\\\"\\n                  : `Environ ${commune.mer} minutes`}\\n              \u003c/p\u003e\\n            \u003c/article\u003e\\n          `).join(\\\"\\\")}\\n        \u003c/div\u003e\\n      `;\\n\\n      resultat.scrollIntoView({\\n        behavior: \\\"smooth\\\"\\n      });\\n    }\\n  });\\n\u003c/script\u003e\\n\",\"html\",{\"_86\":320,\"_302\":321,\"_304\":68,\"_305\":134},\"```javascript\\n\\nimport communes from \\\"../data/communes.json\\\";\\n```\",599,663,[],[],\"\\nimport communes from \\\"../data/communes.json\\\";\\n\",\"javascript\",\"stop\",\"stop_tokens\",[325],200002,\"content_type\",\"text\",\"parts\",[330],\"Parfait Bobby ! Nous allons maintenant connecter notre base de données au questionnaire pour afficher les **3 communes correspondant le mieux aux réponses du visiteur**.\\n\\nNous allons commencer par les critères de proximité de la mer et de type d'environnement. Le budget sera intégré lorsque nous aurons ajouté les prix immobiliers.\\n\\n## Étape 13 — Connecter le questionnaire aux communes\\n\\nOuvre le fichier `src/pages/trouver-ma-ville.astro` dans Visual Studio Code.\\n\\n### 1. Importer notre base de données\\n\\nTout en haut du fichier, juste après les trois tirets `---`, ajoute cette ligne :\\n\\n\u003cCodeBlock language=\\\"javascript\\\" editable\u003e\\nimport communes from \\\"../data/communes.json\\\";\\n\u003c/CodeBlock\u003e\\n\\n### 2. Transmettre les données au questionnaire\\n\\nDescends tout en bas du fichier et repère le bloc `\u003cscript\u003e`.\\n\\nRemplace entièrement ce bloc, jusqu'à `\u003c/script\u003e` inclus, par le code suivant :\\n\\n\u003cCodeBlock language=\\\"html\\\" editable\u003e\\n\u003cscript\u003e\\n  import communes from \\\"../data/communes.json\\\";\\n\\n  const form = document.querySelector\u003cHTMLFormElement\u003e(\\n    \\\"#questionnaire\\\"\\n  );\\n\\n  const resultat = document.querySelector\u003cHTMLElement\u003e(\\n    \\\"#resultat\\\"\\n  );\\n\\n  form?.addEventListener(\\\"submit\\\", (event) =\u003e {\\n    event.preventDefault();\\n\\n    const donnees = new FormData(form);\\n\\n    const environnement = donnees.get(\\\"question-2\\\");\\n    const mer = donnees.get(\\\"question-3\\\");\\n\\n    const classement = communes.map((commune) =\u003e {\\n      let score = 0;\\n\\n      // Préférence pour le type d'environnement\\n      if (\\n        environnement === \\\"Ville animée toute l'année\\\" \u0026\u0026\\n        commune.animation === \\\"toute_annee\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Petite ville avec commerces\\\" \u0026\u0026\\n        commune.type === \\\"petite_ville\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Village traditionnel\\\" \u0026\u0026\\n        commune.type === \\\"village\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Quartier résidentiel calme\\\" \u0026\u0026\\n        commune.type === \\\"residentiel\\\"\\n      ) score += 3;\\n\\n      if (\\n        environnement === \\\"Station balnéaire\\\" \u0026\u0026\\n        commune.type === \\\"station\\\"\\n      ) score += 3;\\n\\n      // Préférence pour la proximité de la mer\\n      if (\\n        mer === \\\"En bord de mer\\\" \u0026\u0026\\n        commune.mer === 0\\n      ) score += 3;\\n\\n      if (\\n        mer === \\\"Moins de 10 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 10\\n      ) score += 2;\\n\\n      if (\\n        mer === \\\"Moins de 20 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 20\\n      ) score += 2;\\n\\n      if (\\n        mer === \\\"Moins de 30 minutes\\\" \u0026\u0026\\n        commune.mer \u003c= 30\\n      ) score += 2;\\n\\n      return { ...commune, score };\\n    });\\n\\n    classement.sort((a, b) =\u003e b.score - a.score);\\n\\n    const selection = classement.slice(0, 3);\\n\\n    if (resultat) {\\n      resultat.hidden = false;\\n\\n      resultat.innerHTML = `\\n        \u003ch2\u003eLes communes correspondant à votre recherche\u003c/h2\u003e\\n\\n        \u003cdiv class=\\\"resultats\\\"\u003e\\n          ${selection.map((commune) =\u003e `\\n            \u003carticle class=\\\"resultat-card\\\"\u003e\\n              \u003ch3\u003e${commune.nom}\u003c/h3\u003e\\n              \u003cp\u003e${commune.description}\u003c/p\u003e\\n              \u003cp\u003e\\n                \u003cstrong\u003eDistance de la mer :\u003c/strong\u003e\\n                ${commune.mer === 0\\n                  ? \\\"En bord de mer\\\"\\n                  : `Environ ${commune.mer} minutes`}\\n              \u003c/p\u003e\\n            \u003c/article\u003e\\n          `).join(\\\"\\\")}\\n        \u003c/div\u003e\\n      `;\\n\\n      resultat.scrollIntoView({\\n        behavior: \\\"smooth\\\"\\n      });\\n    }\\n  });\\n\u003c/script\u003e\\n\u003c/CodeBlock\u003e\\n\\n\u003ctext color=\\\"secondary\\\" size=\\\"sm\\\"\u003eL'import placé dans le script est celui qui sert au calcul dans le navigateur. Celui ajouté en haut du fichier n'est pas nécessaire pour cette étape : tu peux donc ne conserver que l'import du script.\u003c/text\u003e\\n\\n### 3. Ajouter le style des résultats\\n\\nDans le même fichier, juste avant `\u003c/style\u003e`, colle :\\n\\n\u003cCodeBlock language=\\\"css\\\" editable\u003e\\n#resultat {\\n  margin-top: 45px;\\n}\\n\\n#resultat h2 {\\n  text-align: center;\\n  color: #167b88;\\n  margin-bottom: 30px;\\n}\\n\\n.resultats {\\n  display: grid;\\n  gap: 20px;\\n}\\n\\n.resultat-card {\\n  background: white;\\n  border-left: 5px solid #167b88;\\n  border-radius: 10px;\\n  padding: 25px;\\n  box-shadow: 0 4px 15px #00000012;\\n}\\n\\n.resultat-card h3 {\\n  color: #167b88;\\n  font-size: 24px;\\n  margin-top: 0;\\n}\\n\\n.resultat-card p {\\n  line-height: 1.7;\\n}\\n\u003c/CodeBlock\u003e\\n\\n## 4. Tester le questionnaire\\n\\nEnregistre avec `Ctrl + S`, puis ouvre `http://localhost:4321/trouver-ma-ville/`.\\n\\n\u003cbox border={{size:1,color:\\\"#24976c\\\"}} radius=\\\"xl\\\" padding={3} gap={3}\u003e\\n  \u003ctitle size=\\\"lg\\\"\u003ePremier test\u003c/title\u003e\\n  \u003ctext color=\\\"secondary\\\"\u003eSélectionne les réponses suivantes :\u003c/text\u003e\\n  \u003ctable\u003e\\n    \u003ctable-row\u003e\u003ctable-cell\u003eProjet\u003c/table-cell\u003e\u003ctable-cell\u003eRésidence secondaire\u003c/table-cell\u003e\u003c/table-row\u003e\\n    \u003ctable-row\u003e\u003ctable-cell\u003eBudget\u003c/table-cell\u003e\u003ctable-cell\u003e150 000 à 200 000 €\u003c/table-cell\u003e\u003c/table-row\u003e\\n    \u003ctable-row\u003e\u003ctable-cell\u003eEnvironnement\u003c/table-cell\u003e\u003ctable-cell\u003eVillage traditionnel\u003c/table-cell\u003e\u003c/table-row\u003e\\n    \u003ctable-row\u003e\u003ctable-cell\u003eMer\u003c/table-cell\u003e\u003ctable-cell\u003eMoins de 20 minutes\u003c/table-cell\u003e\u003c/table-row\u003e\\n  \u003c/table\u003e\\n  Clique sur **Découvrir les villes**.\\n  \u003ctext weight=\\\"semibold\\\"\u003eRésultat attendu :\u003c/text\u003e\\n  \u003ctext\u003eMont-roig del Camp, Montbrió del Camp et Riudoms devraient apparaître dans les résultats.\u003c/text\u003e\\n\u003c/box\u003e\\n\\n\u003ctext color=\\\"secondary\\\" size=\\\"sm\\\"\u003eCes premières suggestions sont expérimentales : elles reposent uniquement sur les critères géographiques et le type de commune, sans vérification des prix ni de la disponibilité des logements.\u003c/text\u003e\\n\\nDis-moi « fait » si les trois communes s'affichent correctement, ou envoie-moi une capture d'écran si tu rencontres une erreur.\",\"role\",\"assistant\",\"name\",{},{\"_331\":343,\"_333\":-5,\"_92\":344},1790341377.562,1790341398.931032,{\"_326\":327,\"_328\":341},{\"_117\":118,\"_340\":-5,\"_121\":122,\"_123\":122,\"_125\":31},\"message_source\",[342],\"fait\",\"user\",{},\"fc64ea27-1654-4843-ab81-e8cc5857aa76\",{\"_331\":332,\"_333\":-5,\"_92\":414},1790341267.061327,1790341344.44227,{\"_326\":327,\"_32