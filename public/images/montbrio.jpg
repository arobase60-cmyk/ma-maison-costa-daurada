true},"kh_tin":{"type":"kh_tin","region":"KH","placeholder":"1001-123456789","verifiable":false,"stripe_type":"kh_tin","reverse_charge":true,"description":"Cambodian Tax Identification Number","country":"KH","country_label":"Cambodia","supported":true,"format":"[0-9]{4}-[0-9]{9}"},"mx_rfc":{"type":"mx_rfc","reverse_charge":true,"placeholder":"ABC010203AB9","verifiable":false,"replacement_string":"\\1\\2\\3\\4\\5\\6","format":"([A-Za-zÑñ\u0026]{3,4})-?([0-9]{2})(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])-?([A-Za-z0-9])-?([A-Za-z0-9][0-9A])","country_label":"Mexico","region":"MX","supported":true,"stripe_type":"mx_rfc","description":"Mexican RFC number","country":"MX"},"pl_vat":{"placeholder":"PL1234567890","country_label":"Poland","verifiable":true,"region":"EEA-GB-CH","type":"pl_vat","country":"PL","format":"PL[0-9]{10}","stripe_type":"eu_vat","description":"European VAT number","supported":true,"reverse_charge":true},"hr_vat":{"type":"hr_vat","verifiable":true,"description":"European VAT number","reverse_charge":true,"format":"HR[0-9]{11}","placeholder":"HR12345678912","country_label":"Croatia","region":"EEA-GB-CH","supported":true,"stripe_type":"eu_vat","country":"HR"},"nl_vat":{"country_label":"Netherlands","region":"EEA-GB-CH","format":"NL[0-9]{9}B[0-9]{2}","placeholder":"NL123456789B12","stripe_type":"eu_vat","country":"NL","verifiable":true,"reverse_charge":true,"description":"European VAT number","supported":true,"type":"nl_vat"},"fr_vat":{"region":"EEA-GB-CH","stripe_type":"eu_vat","format":"FR[A-Z0-9]{2}[0-9]{9}","description":"European VAT number","country":"FR","placeholder":"FRAB123456789","type":"fr_vat","country_label":"France","verifiable":true,"supported":true,"reverse_charge":true},"fi_vat":{"country":"FI","description":"European VAT number","region":"EEA-GB-CH","verifiable":true,"stripe_type":"eu_vat","placeholder":"FI12345678","reverse_charge":true,"supported":true,"format":"FI[0-9]{8}","type":"fi_vat","country_label":"Finland"},"bh_vat":{"format":"[0