TMLElement\u003e(\\n          \\\"#resultat\\\"\\n        );\\n\\n        if (resultat) {\\n          resultat.hidden = false;\\n          resultat.scrollIntoView({ behavior: \\\"smooth\\\" });\\n        }\\n      });\\n    \u003c/script\u003e\\n  \u003c/body\u003e\\n\u003c/html\u003e\\n\",[325],[486],\"Parfait Bobby ! Nous allons maintenant créer la page **« Trouver ma ville »**, qui sera l'une des fonctionnalités principales de Ma Maison Costa Daurada.\\n\\nL'objectif est de proposer un questionnaire qui orientera les visiteurs vers les communes correspondant à leur budget, leur mode de vie et leurs préférences.\\n\\n## Étape 11 — Créer la page du questionnaire\\n\\nDans Visual Studio Code, ouvre le dossier `src`, puis `pages`.\\n\\nFais un clic droit sur `pages`, sélectionne **New File (Nouveau fichier)** et nomme-le :\\n\\n\u003cbox border radius=\\\"lg\\\" padding={3}\u003e\\n  \u003crow align=\\\"center\\\"\u003e\\n    \u003ctext weight=\\\"semibold\\\"\u003etrouver-ma-ville.astro\u003c/text\u003e\\n    \u003cspacer/\u003e\\n    \u003cbutton color=\\\"secondary\\\" variant=\\\"outline\\\" onClick={() =\u003e GenUI.copy(\\\"trouver-ma-ville.astro\\\")}\u003e\u003cicon name=\\\"copy\\\" size=\\\"xs\\\"/\u003e Copier\u003c/button\u003e\\n  \u003c/row\u003e\\n\u003c/box\u003e\\n\\nColle ensuite ce code dans le nouveau fichier :\\n\\n\u003cCodeBlock language=\\\"html\\\" editable\u003e\\n---\\nconst questions = [\\n  {\\n    titre: \\\"Quel est votre projet immobilier ?\\\",\\n    choix: [\\n      \\\"Résidence principale\\\",\\n      \\\"Résidence secondaire\\\",\\n      \\\"Préparer ma retraite\\\",\\n      \\\"Investissement locatif\\\"\\n    ]\\n  },\\n  {\\n    titre: \\\"Quel est votre budget ?\\\",\\n    choix: [\\n      \\\"Moins de 100 000 €\\\",\\n      \\\"100 000 à 150 000 €\\\",\\n      \\\"150 000 à 200 000 €\\\",\\n      \\\"200 000 à 300 000 €\\\",\\n      \\\"300 000 à 450 000 €\\\",\\n      \\\"Plus de 450 000 €\\\"\\n    ]\\n  },\\n  {\\n    titre: \\\"Quel environnement préférez-vous ?\\\",\\n    choix: [\\n      \\\"Ville animée toute l'année\\\",\\n      \\\"Petite ville avec commerces\\\",\\n      \\\"Village traditionnel\\\",\\n      \\\"Quartier résidentiel calme\\\",\\n      \\\"Station balnéaire\\\"\\n    ]\\n  },\\n  {\\n    titre: \\\"À quelle distance de la mer ?\\\",\\n    choix: [\\n      \\\"En bord de mer\\\",\\n      \\\"Moins de 10 minutes\\\",\\n      \\\"Moins de 20 minutes\\\",\\n      \\\"Moins de 30 minutes\\\",\\n      \\\"La mer n'est pas une priorité\\\"\\n    ]\\n  }\\n];\\n---\\n\\n\u003chtml lang=\\\"fr\\\"\u003e\\n  \u003chead\u003e\\n    \u003cmeta charset=\\\"UTF-8\\\" /\u003e\\n    \u003cmeta name=\\\"viewport\\\"\\n      content=\\\"width=device-width, initial-scale=1\\\" /\u003e\\n    \u003ctitle\u003eTrouver ma ville | Ma Maison Costa Daurada\u003c/title\u003e\\n    \u003cstyle\u003e\\n      * { box-sizing: border-box; }\\n\\n      body {\\n        margin: 0;\\n        font-family: Arial, sans-serif;\\n        color: #263d46;\\n        background: #f5f8f7;\\n      }\\n\\n      header {\\n        background: white;\\n        padding: 25px 8%;\\n      }\\n\\n      header a {\\n        color: #167b88;\\n        font-size: 23px;\\n        font-weight: bold;\\n        text-decoration: none;\\n      }\\n\\n      main {\\n        max-width: 850px;\\n        margin: 55px auto;\\n        padding: 0 20px;\\n      }\\n\\n      h1 { text-align: center; }\\n\\n      .intro {\\n        text-align: center;\\n        line-height: 1.7;\\n        margin-bottom: 40px;\\n      }\\n\\n      .question {\\n        background: white;\\n        padding: 30px;\\n        margin-bottom: 25px;\\n        border-radius: 12px;\\n        box-shadow: 0 4px 15px #0000000a;\\n      }\\n\\n      .question h2 {\\n        font-size: 21px;\\n        color: #167b88;\\n      }\\n\\n      .choix {\\n        display: grid;\\n        gap: 12px;\\n        margin-top: 20px;\\n      }\\n\\n      label {\\n        padding: 14px;\\n        border: 1px solid #d5e1e0;\\n        border-radius: 8px;\\n        cursor: pointer;\\n      }\\n\\n      label:hover {\\n        background: #e9f3f2;\\n      }\\n\\n      input { margin-right: 10px; }\\n\\n      button {\\n        display: block;\\n        margin: 35px auto;\\n        padding: 17px 35px;\\n        background: #e7b65c;\\n        border: none;\\n        border-radius: 8px;\\n        color: #263d46;\\n        font-size: 17px;\\n        font-weight: bold;\\n        cursor: pointer;\\n      }\\n    \u003c/style\u003e\\n  \u003c/head\u003e\\n\\n  \u003cbody\u003e\\n    \u003cheader\u003e\\n      \u003ca href=\\\"/\\\"\u003eMa Maison Costa Daurada\u003c/a\u003e\\n    \u003c/header\u003e\\n\\n    \u003cmain\u003e\\n      \u003ch1\u003eTrouvez votre ville idéale\u003c/h1\u003e\\n\\n      \u003cp class=\\\"intro\\\"\u003e\\n        Répondez à quelques questions pour découvrir\\n        les communes de la Costa Daurada qui\\n        correspondent à votre projet immobilier.\\n      \u003c/p\u003e\\n\\n      \u003cform id=\\\"questionnaire\\\"\u003e\\n        {questions.map((question, index) =\u003e (\\n          \u003csection class=\\\"question\\\"\u003e\\n            \u003ch2\u003e{index + 1}. {question.titre}\u003c/h2\u003e\\n\\n            \u003cdiv class=\\\"choix\\\"\u003e\\n              {question.choix.map((choix) =\u003e (\\n                \u003clabel\u003e\\n                  \u003cinput\\n                    type=\\\"radio\\\"\\n                    name={`question-${index}`}\\n                    value={choix}\\n                    required\\n                  /\u003e\\n                  {choix}\\n                \u003c/label\u003e\\n              ))}\\n            \u003c/div\u003e\\n          \u003c/section\u003e\\n        ))}\\n\\n        \u003cbutton type=\\\"submit\\\"\u003e\\n          Découvrir les villes\\n        \u003c/button\u003e\\n      \u003c/form\u003e\\n\\n      \u003csection id=\\\"resultat\\\" hidden\u003e\\n        \u003ch2\u003eVotre recherche est enregistrée\u003c/h2\u003e\\n        \u003cp\u003e\\n          Nous allons bientôt ajouter les recommandations\\n          personnalisées de communes.\\n        \u003c/p\u003e\\n      \u003c/section\u003e\\n    \u003c/main\u003e\\n\\n    \u003cscript\u003e\\n      const form = document.querySelector\u003cHTMLFormElement\u003e(\\n        \\\"#questionnaire\\\"\\n      );\\n\\n      form?.addEventListener(\\\"submit\\\", (event) =\u003e {\\n        event.preventDefault();\\n\\n        const resultat = document.querySelector\u003cHTMLElement\u003e(\\n          \\\"#resultat\\\"\\n        );\\n\\n        if (resultat) {\\n          resultat.hidden = false;\\n          resultat.scrollIntoView({ behavior: \\\"smooth\\\" });\\n        }\\n      });\\n    \u003c/script\u003e\\n  \u003c/body\u003e\\n\u003c/html\u003e\\n\u003c/CodeBlock\u003e\\n\\nEnregistre avec `Ctrl + S`.\\n\\n\u003cbox border={{size:1,color:\\\"#16a34a\\\"}} radius=\\\"xl\\\" padding={3} gap={2}\u003e\\n  \u003cbadge color=\\\"success\\\"\u003eVérification\u003c/badge\u003e\\n  Ouvre cette adresse dans Chrome :\\n  \u003ctext weight=\\\"semibold\\\"\u003ehttp://localhost:4321/trouver-ma-ville/\u003c/text\u003e\\n  \u003cbutton color=\\\"primary\\\" onClick={() =\u003e GenUI.openUrl(\\\"http://localhost:4321/trouver-ma-ville/\\\")}\u003eOuvrir le questionnaire \u003cicon name=\\\"external-link\\\" size=\\\"xs\\\"/\u003e\u003c/button\u003e\\n  Tu dois voir quatre questions avec des réponses à sélectionner et un bouton « Découvrir les villes ».\\n\u003c/box\u003e\\n\\nPour l'instant, c'est une première version fonctionnelle du formulaire, sans envoi de données ni recommandations réelles. Nous ajouterons ensuite les critères détaillés et notre base de données des communes situées à moins de 40 km de Cambrils.\\n\\n**Dis-moi « fait » lorsque le questionnaire s'affiche correctement.**\",{},{\"_331\":343,\"_333\":-5,\"_92\":494},1790341093.445,1790341118.029681,{\"_326\":327,\