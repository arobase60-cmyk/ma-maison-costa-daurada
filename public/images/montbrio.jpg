8px; margin-top: 5.94595px;"><div class="[&amp;_[data-virtualized-turn-content]]:[content-visibility:visible]" data-turn-key="4f943ad1-3ffd-4187-b2df-03f8819e54ee"><div class="flex flex-col gap-1.5" data-content-search-turn-key="fallback-turn-30"><div class="contents"><div class="contents"><div class="group flex flex-col pb-2 pt-2"><div class="flex flex-col gap-3 browser:gap-1"><div class="block-BQZwFn"><h4 class="sr-only m-0 select-none">Vous avez dit :</h4><div class="group/user-message flex flex-col items-end gap-2" data-chatgpt-search-unit-key="fallback-turn-30:0:user" data-chatgpt-search-message-ids="4f943ad1-3ffd-4187-b2df-03f8819e54ee"><div class="w-full" data-content-search-unit-key="fallback-turn-30:0:user"><div class="group/user-message flex w-full flex-col items-end justify-end gap-1"><div data-user-message-bubble="true" class="bg-user-message text-user-message min-w-0 max-w-(--user-chat-width) overflow-hidden break-words px-(--thread-content-margin) [&amp;_.contain-inline-size]:[contain:initial] bubble-vBnidZ py-2.5 rounded-2xl relative text-start"><div class="flex flex-col items-end gap-1"><div class="relative w-full min-w-0 text-size-chat leading-relaxed"><div class="overflow-hidden" data-search-result-target="" style="max-height: 494px;"><div><div class="text-size-chat whitespace-pre-wrap" dir="auto">// Une commune dépassant le budget
  // reçoit une pénalité.
  const penaliteA =
    a.compatible === false ? 4 : 0;

  const penaliteB =
    b.compatible === false ? 4 : 0;

  const scoreA = a.score + bonusA - penaliteA;
  const scoreB = b.score + bonusB - penaliteB;

  return scoreB - scoreA;
});


    const selection = classement.slice(0, 3);

    if (resultat) {
      resultat.hidden = false;

      resultat.innerHTML = `
        &lt;h2&gt;Les communes correspondant à votre recherche&lt;/h2&gt;

        &lt;div class="resultats"&gt;
          ${selection.map((commune) =&gt; `
            &lt;article class="resultat-card"&gt;
              &lt;h3&gt;${commune.nom}&lt;/h3&gt;
             
             
              &lt;p&gt;${commune.description}&lt;/p&gt;
              
  
&lt;p&gt;
  &lt;strong&gt;Distance de la mer :&lt;/strong&gt;
  ${commune.mer === 0
    ? "En bord de mer"
    : "Environ " + commune.mer + " minutes"}
&lt;/p&gt;

  
              ${commune.prixM2 !== null
    ? commune.prixM2.toLocaleString("fr-FR", {
        style: "currency",
        currency: "EUR"
      })
    : "Données à compléter"}
&lt;/p&gt;

&lt;p&gt;
  &lt;strong&gt;Coût estimé :&lt;/strong&gt;
  ${commune.coutEstime !== null
    ? commune.coutEstime.toLocaleString("fr-FR", {
        style: "currency",
        currency: "EUR",
        maximumFractionDigits: 0
      })
    : "Estimation indisponible"}
&lt;/p&gt;

&lt;p&gt;
  &lt;strong&gt;Budget :&lt;/strong&gt;
  ${commune.compatible === null
    ? "À vérifier"
    : commune.compatible
      ? "Compatible avec votre budget estimé"
      : "Supérieur à votre budget estimé"}
