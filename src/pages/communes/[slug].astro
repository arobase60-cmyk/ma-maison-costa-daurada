
---
import communes from "../../data/communes.json";

export function getStaticPaths() {
  return communes.map((commune) => {
    const slug = commune.nom
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

    return {
      params: { slug },
      props: { commune }
    };
  });
}

const { commune } = Astro.props;
const quartiers = "quartiers" in commune
  ? (commune.quartiers ?? [])
  : [];
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{commune.nom} | Ma Maison Costa Daurada</title>
  </head>

  <body>
    <main>
      <a href="/trouver-ma-ville/">← Retour aux résultats</a>

      <h1>Découvrir {commune.nom}</h1>

      {commune.image && (
        <img src={commune.image} alt={commune.nom} />
      )}

      <p>{commune.description}</p>

      
<h2>Vivre à {commune.nom}</h2>

<div class="infos-grid">

  <div class="info-card">
    <strong>🌊 Proximité de la mer</strong>
    <p>
      {commune.mer === 0
        ? "En bord de mer"
        : `À environ ${commune.mer} minutes de la mer`}
    </p>
  </div>

  <div class="info-card">
    <strong>🛍️ Commerces</strong>
    <p>
      {commune.commerces
        ? "Commerces et services disponibles"
        : "Disponibilité à vérifier"}
    </p>
  </div>

  <div class="info-card">
    <strong>🚆 Gare ferroviaire</strong>
    <p>
      {commune.gare
        ? "Gare dans la commune"
        : "Pas de gare dans la commune"}
    </p>
  </div>

  <div class="info-card">
    <strong>☀️ Ambiance</strong>
    <p>
      {commune.animation === "toute_annee"
        ? "Vivante toute l'année"
        : commune.animation === "calme"
          ? "Calme et résidentielle"
          : "Animée principalement en saison"}
    </p>
  </div>

</div>

<section class="immobilier-card">
  <h2>Immobilier à {commune.nom}</h2>

  <div class="prix-immobilier">
    <div>Prix indicatif au m²</div>

    <div>
      {commune.prixM2 != null
        ? `${commune.prixM2.toLocaleString("fr-FR")} €`
        : "Données à compléter"}
    </div>

    {commune.anneePrix && (
      <small>Référence : {commune.anneePrix}</small>
    )}
  </div>

  {commune.sourcePrix && (
    <p>
      <strong>Source :</strong> {commune.sourcePrix}
    </p>
  )}

  <h3>Types de biens</h3>

  <ul>
    {commune.typesBiens?.map((type) => (
      <li>{type}</li>
    ))}
  </ul>

  <p>
    <small>
      Prix indicatifs susceptibles de varier selon le quartier,
      l'état et les caractéristiques du logement.
    </small>
  </p>
</section>


{quartiers.length > 0 && (
  <section class="quartiers-section">
    <h2>Les quartiers où acheter à {commune.nom}</h2>

    <div class="quartiers-grid">
      {quartiers.map((quartier) => (
        <article class="quartier-card">
          <h3>{quartier.nom}</h3>
          <p>{quartier.description}</p>
        </article>
      ))}
    </div>
  </section>
)}



      
<section class="contact-card">
  <h2>Un projet immobilier à {commune.nom} ?</h2>

  <p>
    Besoin d'aide pour trouver un bien, organiser vos visites
    ou préparer votre installation sur la Costa Daurada ?
  </p>

  <a
    href={`/?commune=${encodeURIComponent(commune.nom)}#contact`}
    class="contact-button"
  >
    Parlons de votre projet →
  </a>
</section>

    </main>

<footer class="site-footer">
  <p>© 2026 Ma Maison Costa Daurada</p>

  <nav aria-label="Informations juridiques">
    <a href="/mentions-legales/">Mentions légales</a>
    <a href="/politique-confidentialite/">Confidentialité</a>
    <a href="/politique-cookies/">Cookies</a>
    <a href="/cgv/">CGV</a>
  </nav>
</footer>



  </body>
</html>

<style>
  body {
    font-family: Arial, sans-serif;
    background: #f7fbfb;
    color: #263d46;
    margin: 0;
  }

  main {
    max-width: 950px;
    margin: 40px auto;
    padding: 30px;
  }

  h1, h2 {
    color: #176b78;
  }

  img {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 14px;
    margin: 25px 0;
  }

  a {
    color: #176b78;
    font-weight: bold;
  }
  .contact-button {
  display: inline-block;
  background: #e7b65c;
  color: #263d46;
  padding: 16px 24px;
  border-radius: 10px;
  text-decoration: none;
  font-weight: bold;
  margin-top: 30px;
}

.contact-button:hover {
  background: #dca342;
}
.immobilier-card {
  background: white;
  border: 1px solid #dce9e9;
  border-radius: 16px;
  padding: 28px;
  margin: 30px 0;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
}

.prix-immobilier {
  background: #edf7f7;
  border-radius: 12px;
  padding: 22px;
  text-align: center;
  color: #176b78;
  font-size: 28px;
  font-weight: bold;
}

.infos-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin: 25px 0 35px;
}

.info-card {
  background: white;
  border: 1px solid #dce9e9;
  border-radius: 14px;
  padding: 22px;
}

.info-card strong {
  display: block;
  color: #176b78;
  font-size: 18px;
  margin-bottom: 10px;
}

@media (max-width: 600px) {
  .infos-grid {
    grid-template-columns: 1fr;
  }
}


.contact-card {
  background: #edf7f7;
  border: 1px solid #dce9e9;
  border-radius: 16px;
  padding: 35px 25px;
  margin: 40px 0;
  text-align: center;
}

.contact-card h2 {
  color: #176b78;
  margin-top: 0;
  font-size: 28px;
}

.contact-card p {
  max-width: 600px;
  margin: 15px auto 25px;
  line-height: 1.6;
}

.contact-card .contact-button {
  display: inline-block;
  background: #e7b65c;
  color: #263d46;
  padding: 16px 28px;
  border-radius: 10px;
  text-decoration: none;
  font-weight: bold;
}

.contact-card .contact-button:hover {
  background: #dca342;
}

.quartiers-section {
  margin: 50px auto;
}

.quartiers-section h2 {
  color: #263d46;
  margin-bottom: 24px;
}

.quartiers-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.quartier-card {
  background: #f4f8f8;
  border: 1px solid #e0e9e9;
  border-radius: 14px;
  padding: 25px;
}

.quartier-card h3 {
  color: #263d46;
  margin: 0 0 12px;
}

.quartier-card p {
  line-height: 1.7;
  margin: 0;
}

@media (max-width: 650px) {
  .quartiers-grid {
    grid-template-columns: 1fr;
  }
}

.site-footer {
  margin-top: 60px;
  padding: 35px 20px;
  background: #263d46;
  color: white;
  text-align: center;
}

.site-footer p {
  margin: 0 0 18px;
}

.site-footer nav {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px 25px;
}

.site-footer a {
  color: #e7b65c;
  text-decoration: none;
  font-size: 14px;
}

.site-footer a:hover {
  text-decoration: underline;
}



</style>
