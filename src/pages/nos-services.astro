
---
const title = "Nos services | Ma Maison Costa Daurada";

const description =
  "Recherche immobilière, accompagnement de rénovation et démarches d'achat en Espagne : découvrez les services de Ma Maison Costa Daurada pour votre projet immobilier.";

const services = [
  {
    numero: "01",
    titre: "Recherche immobilière",
    description:
      "Vous aider à définir votre projet, à découvrir les communes de la Costa Daurada et à orienter vos recherches selon votre budget et vos critères.",
    points: [
      "Définition de vos critères",
      "Découverte des villes et villages",
      "Préparation de votre recherche immobilière",
    ],
    lien: "/recherche-immobiliere-costa-daurada/",
    bouton: "Découvrir l'accompagnement immobilier",
  },
  {
    numero: "02",
    titre: "Artisans et rénovation",
    description:
      "Profitez de mon expérience de plus de 20 ans comme conducteur de travaux, complétée par mes propres projets d'achat, de rénovation et de revente de logements.",
    points: [
      "Recherche et sélection d'artisans",
      "Analyse et comparaison des devis",
      "Accompagnement pendant les travaux",
    ],
    lien: "/artisans-renovation-costa-daurada/",
    bouton: "Découvrir l'accompagnement travaux",
  },
  {
    numero: "03",
    titre: "Démarches pour acheter en Espagne",
    description:
      "Mieux comprendre les formalités d'un achat immobilier en Espagne, anticiper les étapes importantes et identifier les professionnels compétents.",
    points: [
      "Préparation des démarches administratives",
      "Informations sur le NIE et les étapes d'achat",
      "Orientation vers les professionnels adaptés",
    ],
    lien: "/demarches-achat-immobilier-espagne/",
    bouton: "Découvrir les démarches d'achat",
  },
];
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link
      rel="canonical"
      href="https://ma-maison-costa-daurada.pages.dev/nos-services/"
    />
  </head>

  <body>
    <header class="hero">
      <a href="/" class="retour">← Retour à l'accueil</a>

      <div class="hero-content">
        <p class="surtitre">MA MAISON COSTA DAURADA</p>

        <h1>Un accompagnement pour votre projet immobilier en Espagne</h1>

        <p class="introduction">
          De la recherche de votre futur logement aux travaux de rénovation,
          en passant par les démarches d'achat, découvrez comment
          je peux vous aider à préparer votre projet sur la Costa Daurada.
        </p>

        <a class="bouton" href="/#contact">
          Parlons de votre projet
        </a>
      </div>
    </header>

    <main>
      <section class="section introduction-services">
        <h2>Trois services pour vous accompagner</h2>

        <p>
          Acheter un logement dans un pays étranger soulève de nombreuses
          questions. Où chercher ? Comment organiser les travaux ?
          Quelles démarches faut-il anticiper ?
        </p>

        <p>
          Mon objectif est de partager mon expérience et de vous aider
          à avancer dans votre projet, en fonction de vos besoins.
        </p>

        <div class="grille-services">
          {
            services.map((service) => (
              <article class="carte-service">
                <span class="numero">{service.numero}</span>

                <h3>{service.titre}</h3>

                <p>{service.description}</p>

                <ul>
                  {service.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>

                <a href={service.lien} class="lien-service">
                  {service.bouton} →
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section">
        <div class="experience">
          <span class="experience-label">
            MON EXPÉRIENCE
          </span>

          <h2>
            Une expérience professionnelle et personnelle
            au service de votre projet
          </h2>

          <p>
            J'ai exercé pendant plus de 20 ans comme conducteur
            de travaux. En parallèle, j'ai réalisé mes propres
            opérations immobilières : achat de logements,
            rénovation et revente.
          </p>

          <p>
            J'ai également connu les difficultés que l'on peut
            rencontrer lorsqu'on arrive en Espagne :
            démarches administratives, différences de pratiques
            et recherche de professionnels.
          </p>

          <p>
            C'est cette double expérience que je souhaite
            aujourd'hui partager avec les francophones
            qui envisagent d'acheter sur la Costa Daurada.
          </p>

          <a href="/mon-histoire/" class="lien-experience">
            Découvrez mon histoire →
          </a>
        </div>
      </section>

      <section class="section section-parcours">
        <h2>Vous ne savez pas encore où acheter ?</h2>

        <p>
          Cambrils, Salou, Mont-roig del Camp, Miami Platja
          ou une commune de l'arrière-pays :
          chaque lieu possède ses particularités.
        </p>

        <p>
          Répondez à quelques questions pour découvrir
          les communes qui pourraient correspondre
          à votre projet.
        </p>

        <a href="/trouver-ma-ville/" class="bouton bouton-secondaire">
          Trouver ma ville
        </a>
      </section>

      <section class="contact">
        <h2>Parlons de votre projet sur la Costa Daurada</h2>

        <p>
          Vous recherchez un bien immobilier,
          envisagez des travaux ou avez besoin
          d'informations sur les démarches d'achat ?
          Présentez-moi votre projet.
        </p>

        <a href="/#contact" class="bouton">
          Me contacter
        </a>
      </section>

      <section class="precision">
        <p>
          Les prestations sont définies selon les besoins
          et la situation de chaque client. L'accompagnement
          proposé ne remplace pas les interventions
          réglementées des agents immobiliers, architectes,
          avocats, notaires ou conseillers fiscaux
          habilités en Espagne.
        </p>
      </section>
    </main>

    <footer class="site-footer">
      <p>© 2026 Ma Maison Costa Daurada</p>

      <nav aria-label="Informations juridiques">
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/politique-confidentialite/">
          Confidentialité
        </a>
        <a href="/politique-cookies/">Cookies</a>
        <a href="/cgv/">CGV</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: Arial, sans-serif;
    color: #263d46;
    background: white;
    line-height: 1.7;
  }

  .hero {
    padding: 30px 25px 85px;
    background: linear-gradient(135deg, #263d46, #397b80);
    color: white;
  }

  .retour {
    color: #f2cf8e;
    text-decoration: none;
    font-weight: bold;
  }

  .hero-content {
    max-width: 950px;
    margin: 65px auto 0;
    text-align: center;
  }

  .surtitre {
    color: #f2cf8e;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.2;
    margin: 20px 0;
  }

  .introduction {
    max-width: 750px;
    margin: 0 auto 35px;
    font-size: 19px;
  }

  .bouton {
    display: inline-block;
    padding: 15px 28px;
    background: #e7b65c;
    color: #263d46;
    border-radius: 10px;
    font-weight: bold;
    text-decoration: none;
  }

  .bouton:hover {
    background: #f2cf8e;
  }

  .section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 65px 25px;
  }

  h2 {
    font-size: clamp(27px, 4vw, 36px);
    line-height: 1.3;
  }

  .introduction-services > p {
    max-width: 850px;
  }

  .grille-services {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin-top: 40px;
  }

  .carte-service {
    display: flex;
    flex-direction: column;
    padding: 30px;
    background: #f4f8f8;
    border: 1px solid #e0eaea;
    border-radius: 15px;
  }

  .numero {
    color: #c18a32;
    font-size: 30px;
    font-weight: bold;
  }

  .carte-service h3 {
    font-size: 23px;
    line-height: 1.3;
    margin: 15px 0 10px;
  }

  .carte-service ul {
    padding-left: 20px;
    margin-bottom: 30px;
  }

  .carte-service li {
    margin-bottom: 9px;
  }

  .lien-service {
    margin-top: auto;
    color: #237c80;
    font-weight: bold;
    text-decoration: none;
  }

  .lien-service:hover,
  .lien-experience:hover {
    text-decoration: underline;
  }

  .experience {
    padding: 40px;
    background: #fff8e9;
    border-left: 5px solid #e7b65c;
    border-radius: 12px;
  }

  .experience-label {
    color: #a6782f;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1.5px;
  }

  .lien-experience {
    display: inline-block;
    margin-top: 15px;
    color: #237c80;
    font-weight: bold;
    text-decoration: none;
  }

  .section-parcours {
    text-align: center;
    background: #f4f8f8;
    border-radius: 18px;
  }

  .section-parcours p {
    max-width: 750px;
    margin-left: auto;
    margin-right: auto;
  }

  .bouton-secondaire {
    margin-top: 20px;
  }

  .contact {
    padding: 70px 25px;
    background: #e8f2f1;
    text-align: center;
  }

  .contact p {
    max-width: 700px;
    margin: 0 auto 30px;
  }

  .precision {
    max-width: 1050px;
    margin: 0 auto;
    padding: 25px;
    color: #60747a;
    font-size: 13px;
  }

  .site-footer {
    padding: 35px 20px;
    background: #263d46;
    color: white;
    text-align: center;
  }

  .site-footer nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px 25px;
    margin-top: 18px;
  }

  .site-footer a {
    color: #e7b65c;
    text-decoration: none;
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .grille-services {
      grid-template-columns: 1fr;
    }

    .carte-service {
      padding: 25px;
    }
  }

  @media (max-width: 700px) {
    .hero-content {
      margin-top: 45px;
    }

    .section {
      padding: 45px 20px;
    }

    .experience {
      padding: 25px;
    }
  }
</style>
